{
  "_about": "Rules for model-effort-router. Copy with `router.py init` to .claude/model-router.json and edit; a top-level key you set replaces the default one. Patterns are Python regular expressions, matched case-insensitively; a sentence that denies a pattern (see negation) does not count. paths are glob patterns over repository paths (src/billing/*). The hook section controls automatic routing of subagents.",
  "ladder": [
    [
      "sonnet",
      "medium"
    ],
    [
      "sonnet",
      "high"
    ],
    [
      "opus",
      "high"
    ],
    [
      "opus",
      "xhigh"
    ]
  ],
  "thresholds": [
    [
      9,
      2
    ],
    [
      6,
      1
    ],
    [
      0,
      0
    ]
  ],
  "retry_jumps_model": true,
  "max_worker_retries": 2,
  "size": {
    "pattern": "(?:\\*\\*)?size(?:\\*\\*)?:?(?:\\*\\*)?\\s*(XS|S|M|L|XL)\\b",
    "points": {
      "XS": 0,
      "S": 1,
      "M": 2,
      "L": 4,
      "XL": 6
    },
    "default": 2
  },
  "criteria": {
    "start": "acceptance criteria",
    "end": "^(#{1,6} |\\*\\*[A-Z][^*]*\\*\\*)",
    "item": "^\\s*(\\d+[.)]|[-*] \\[[ xX]\\]|[-*])\\s",
    "bands": [
      [
        10,
        2
      ],
      [
        7,
        1
      ]
    ]
  },
  "depends": {
    "line": "^.*depends on.*$",
    "item": "#\\d+|\\b[A-Z][A-Z0-9]+-\\d+(?:\\.\\d+)?\\b",
    "over": 4,
    "points": 1
  },
  "signals": [
    {
      "name": "database schema",
      "points": 1,
      "pattern": "\\b(migration|schema|new table|alter table|create table)\\b"
    },
    {
      "name": "permissions or personal data",
      "points": 1,
      "pattern": "\\b(permission|authori[sz]ation|roles?|personal data|PII|secrets?)\\b"
    },
    {
      "name": "user interface",
      "points": 1,
      "pattern": "\\b(UI|screen|page|frontend|component)\\b"
    },
    {
      "name": "open question",
      "points": 1,
      "pattern": "(open question|\\bTBD\\b|to be decided|owner decides)"
    },
    {
      "name": "shared or build files",
      "points": 1,
      "pattern": "\\b(Makefile|package\\.json|pyproject\\.toml|Dockerfile|CI pipeline|shared module)\\b"
    },
    {
      "name": "concurrency or performance",
      "points": 1,
      "pattern": "\\b(concurren\\w+|race condition|locking|performance|latency)\\b"
    }
  ],
  "critical": {
    "line": "Critical",
    "guess": "\\b(critical path|ledger|billing engine|authentication flow|cryptograph\\w*|golden (?:test|file)s?)\\b",
    "guess_acts": false,
    "paths": []
  },
  "risk": {
    "line": "Risk",
    "floor": 2,
    "kinds": {
      "money": {
        "meaning": "changes a calculation, a price, a limit or a payment",
        "pattern": "\\b(pricing|price|interest|fee|payment|invoice|limit|calculation)\\b"
      },
      "security": {
        "meaning": "changes authentication, permissions or personal-data handling",
        "pattern": "\\b(authentication|permission|access control|personal data|PII|encryption)\\b"
      },
      "data": {
        "meaning": "changes or migrates data already stored",
        "pattern": "\\b(migrat\\w+|backfill\\w*|existing records|stored data)\\b"
      }
    },
    "paths": {}
  },
  "negation": "\\b(no|not|never|without|unchanged|nothing|untouched)\\b|n't\\b",
  "skip_lines": null,
  "log": "docs/model-router-log.md",
  "labels": {
    "size": "^(?:size[:/ ]\\s*)?(XS|S|M|L|XL)$",
    "critical": [
      "critical"
    ],
    "risk": {
      "security": "security",
      "billing": "money",
      "payments": "money",
      "data-migration": "data",
      "migration": "data"
    }
  },
  "repo": {
    "enabled": true,
    "files_bands": [
      [
        10,
        2
      ],
      [
        4,
        1
      ]
    ],
    "untested_points": 1,
    "churn_days": 90,
    "churn_commits": 10,
    "churn_points": 1,
    "max_files": 50000,
    "code_ext": [
      "py",
      "js",
      "jsx",
      "ts",
      "tsx",
      "go",
      "rs",
      "java",
      "kt",
      "cs",
      "c",
      "cc",
      "cpp",
      "h",
      "hpp",
      "rb",
      "php",
      "swift",
      "scala",
      "sql"
    ]
  },
  "hook": {
    "enabled": true,
    "skip_agent_types": [
      "Explore",
      "claude-code-guide",
      "statusline-setup"
    ],
    "respect_explicit": true,
    "permission_decision": null,
    "runs_log": ".claude/model-router-runs.jsonl",
    "assess": false,
    "_about": "assess: false, true (always) or \"auto\" (only when the task does not state its size). Each assessor call is one cheap model call before the subagent starts."
  },
  "assess": {
    "model": "haiku",
    "effort": "low",
    "max_budget_usd": 0.1,
    "read_repo": true,
    "max_turns": 8,
    "timeout": 180,
    "max_chars": 12000,
    "critical_meaning": "the part of the system where a mistake costs most (for example payments, authentication or the data model)"
  },
  "prices": {
    "_about": "US dollars per million tokens: [input, output, cache read]. Cache writes are priced at 1.25x input (5-minute) and 2x input (1-hour). Anthropic API list prices, November 2026; update them here. A model id matches the longest key it starts with.",
    "claude-fable-5-2": [
      8.0,
      40.0,
      0.2
    ],
    "claude-opus-5-5": [
      4.0,
      20.0,
      0.2
    ],
    "claude-opus-5": [
      5.0,
      25.0,
      0.5
    ],
    "claude-sonnet-5-5": [
      2.0,
      10.0,
      0.1
    ],
    "claude-sonnet-5": [
      2.0,
      10.0,
      0.2
    ],
    "claude-haiku-5-5": [
      0.1,
      0.5,
      0.01
    ],
    "claude-haiku-4-5": [
      1.0,
      5.0,
      0.1
    ]
  },
  "savings_baseline": "claude-opus-5-5",
  "readiness": {
    "_about": "Advice before starting: a vague task fails on every model. It never changes the model or effort.",
    "enabled": true,
    "min_words": 5,
    "criteria_expected_over_words": 120,
    "vague": [
      "correctly",
      "properly",
      "successfully",
      "as expected",
      "should work",
      "looks good",
      "user friendly",
      "user-friendly",
      "seamlessly",
      "efficiently",
      "effectively",
      "appropriately"
    ],
    "open_question": "(open question|\\bTBD\\b|to be decided|to be confirmed)"
  },
  "causes": {
    "_about": "Patterns that suggest whose failure it was, tried in this order: environment, task, worker. Used by `cause` and by `score --retry N --failure-log FILE`.",
    "environment": [
      "No space left on device|disk quota exceeded",
      "ModuleNotFoundError|No module named|Cannot find module",
      "command not found|is not recognized as an internal or external command",
      "Connection refused|ECONNREFUSED|ETIMEDOUT|Connection timed out|Could not resolve host|Temporary failure in name resolution|Network is unreachable",
      "Address already in use|EADDRINUSE",
      "Permission denied|EACCES|Operation not permitted",
      "rate.?limit|\\b429\\b|overloaded|quota exceeded|Credit balance is too low",
      "\\b401\\b|Unauthorized|authentication failed|invalid api key|403 Forbidden",
      "MemoryError|out of memory|OOMKilled|Killed: 9",
      "Cannot connect to the Docker daemon|docker: not found"
    ],
    "task": [
      "ambiguous|underspecified|not specified in the (task|story|issue|ticket)",
      "contradict(s|ory|ion)",
      "needs? (a |the )?(decision|clarification)|waiting for (a |the )?(decision|answer)",
      "blocked (by|on) (a |the )?(decision|question|person)|open question|cannot decide"
    ],
    "worker": [
      "AssertionError|\\bFAILED\\b|\\d+ failed|Tests? failed",
      "expected .* (but )?(got|was|received)",
      "SyntaxError|IndentationError|TypeError|NameError|AttributeError|KeyError|ValueError|IndexError",
      "Traceback \\(most recent call last\\)",
      "error TS\\d+|error\\[E\\d+\\]|compilation (error|failed)|cannot find symbol"
    ]
  },
  "mechanical": {
    "_about": "Off by default (not benchmarked). When on, a short task that only runs a tool goes to this rung, unless it is critical, risky, a retry, or asks for a change.",
    "enabled": false,
    "rung": [
      "haiku",
      "low"
    ],
    "max_words": 60,
    "patterns": "\\b(run|execute|re-?run)\\s+(the\\s+)?(unit\\s+|e2e\\s+|integration\\s+)?(tests?|test suite|linter|lint|formatter|type.?check(er)?|build)\\b|\\b(lint|format)\\s+(the\\s+)?(code|files?|project)\\b|\\bgit\\s+(status|diff|log|branch|stash)\\b|\\b(show|list|print)\\s+(me\\s+)?(the\\s+)?(changes|diff|changed files|test coverage|coverage)\\b|\\bwhat\\s+changed\\b|\\bdocker\\s+(ps|build|compose)\\b",
    "not_if": "\\b(fix|implement|refactor|add|write|change|create|build a|design|migrate|debug|investigate|update)\\b"
  },
  "budget": {
    "_about": "US dollars at API list prices, from Claude Code's usage records for this project. 0 means no limit. `budget` reports against these and exits 1 when one is exceeded. With throttle on, the hook caps first attempts of ordinary tasks at throttle_rung once today's spend passes throttle_at of the daily limit; critical and risky tasks and retries are never capped.",
    "daily": 0,
    "weekly": 0,
    "monthly": 0,
    "alert_at": [
      0.75,
      0.9,
      1.0
    ],
    "throttle": false,
    "throttle_at": 0.8,
    "throttle_rung": 0,
    "cache_minutes": 10
  },
  "state": ".claude/model-router-state.json"
}
